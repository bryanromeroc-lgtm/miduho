# Plantilla de secretos de producción. Copia a .env.production (NUNCA se versiona),
# completa cada valor y protégela: chmod 600 .env.production
# Úsala siempre con: docker compose --env-file .env.production …

# ---------- proxy (Caddy) ----------
# Dominio o IP con que se entra a la plataforma (sin https://).
MIDUHO_DOMINIO=miduho.colegio.example
# Correo para Let's Encrypt (dominio público) o `internal` (servidor en la LAN del colegio).
MIDUHO_TLS=operacion@colegio.example
# Carpeta del host con las páginas de los libros (content/libros, fuera de git).
MIDUHO_LIBROS=./content/libros

# ---------- db, migrate, app y backup (PostgreSQL) ----------
POSTGRES_USER=miduho
# Solo letras y números (va dentro de una URL). Generar: openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_DB=miduho

# ---------- app ----------
# Generar: openssl rand -base64 32   (o npx auth secret)
AUTH_SECRET=
# Etiqueta de la imagen construida (p. ej. el commit). Por defecto: local.
MIDUHO_VERSION=local
# SMTP para recuperación de contraseña 🔶 cuenta de producción por confirmar.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="MIDUHO <no-responder@colegio.example>"

# ---------- backup ----------
# Programación cron (hora de TZ). Por defecto, todos los días a las 2:00.
BACKUP_SCHEDULE="0 2 * * *"
TZ=America/Bogota
# Carpeta del host para los respaldos (separada del volumen de PostgreSQL).
MIDUHO_RESPALDOS=./respaldos

# ---------- solo para la primera carga (prisma/seed.ts vía `migrate`) ----------
# Cuenta administradora inicial. Bórralas del archivo después del primer despliegue.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
