# Dependencias
node_modules/

# Sistema / editores
.DS_Store
*.log

# Variables de entorno (solo se versionan las plantillas)
.env
.env.*
!.env.example
!.env.production.example

# Contenido pesado: PDFs fuente y páginas generadas de los libros.
# Viven fuera de git; en producción se sirven desde almacenamiento de objetos / CDN.
/content/biblioteca/**/*.pdf
/content/biblioteca/**/fuentes/
/content/libros/
/content/referencias/**/*.ogg

# Respaldos de PostgreSQL del stack de producción (deploy/, docker-compose.yml)
/respaldos/
# Credenciales ficticias de la prueba de carga (docs/operacion.md §8)
/carga/

# Salidas de herramientas de navegador y capturas temporales
/output/
.playwright-cli/
.playwright-mcp/

# Estado local de herramientas de IA (personal por máquina)
.claude/settings.local.json
.impeccable/config.local.json
.impeccable/**/hook.cache.json
.impeccable/build/
.impeccable/review/diff/
.impeccable/review/referentes/
.impeccable/review/baseline/
.impeccable/review/regresion-labs/
# Skill instalada como enlace simbólico al home del usuario
.agents/skills/impeccable

# Python
__pycache__/
*.pyc

# Skills de terceros: instalación local, no se versionan (ver .claude/skills/TERCEROS.md)
/.claude/skills/a11y-audit/
/.claude/skills/k12-lesson-*/
/.claude/skills/adaptive-hint-sequence-designer/
/.claude/skills/formative-assessment-*/
/.claude/skills/productive-failure-*/
/.claude/skills/progressive-hint-ladder/
/.claude/skills/spaced-practice-scheduler/
/.claude/skills/game-feel/
/.claude/skills/design-game/

# Perfil de Chrome para gemini-media vive fuera del repo; salidas temporales
/tools/gemini-media/salida/
