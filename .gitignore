# Dependencias
node_modules/

# Sistema / editores
.DS_Store
*.log

# Variables de entorno (solo se versionan las plantillas)
.env
.env.*
!.env.example
!.env.production.example

# Contenido pesado: PDFs fuente y páginas generadas de los libros.
# Viven fuera de git; en producción se sirven desde almacenamiento de objetos / CDN.
/content/biblioteca/**/*.pdf
/content/libros/

# Respaldos de PostgreSQL del stack de producción (deploy/, docker-compose.yml)
/respaldos/
# Credenciales ficticias de la prueba de carga (docs/operacion.md §8)
/carga/

# Salidas de herramientas de navegador y capturas temporales
/output/
.playwright-cli/
.playwright-mcp/

# Estado local de herramientas de IA (personal por máquina)
.claude/settings.local.json
.impeccable/config.local.json
.impeccable/**/hook.cache.json
.impeccable/build/
.impeccable/review/diff/
.impeccable/review/referentes/
.impeccable/review/baseline/
.impeccable/review/regresion-labs/
# Skill instalada como enlace simbólico al home del usuario
.agents/skills/impeccable

# Python
__pycache__/
*.pyc
