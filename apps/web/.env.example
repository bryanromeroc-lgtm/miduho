# Copia a .env y completa. Nunca versionar .env.
# PostgreSQL local de docker-compose.dev.yml (credenciales ficticias de desarrollo).
# Si usas MIDUHO_PG_PUERTO, cambia el puerto aquí también.
DATABASE_URL="postgresql://miduho:miduho@localhost:5432/miduho"
# Servidor para `npm test` (base de mantenimiento): crea y borra bases miduho_test_*.
TEST_DATABASE_URL="postgresql://miduho:miduho@localhost:5432/postgres"
# Generar con: npx auth secret
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST=true
# Solo bases administradas que exigen TLS (Heroku Postgres): no-verify. Ver src/lib/entorno.ts.
DATABASE_SSL=""
# SMTP para recuperación de contraseña (sin SMTP_HOST, en desarrollo el enlace sale por consola)
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="MIDUHO <no-responder@colegio.example>"
# Seed: cuenta administradora ficticia
SEED_ADMIN_EMAIL="admin@miduho.test"
SEED_ADMIN_PASSWORD=""
