// MIDUHO — esquema Prisma (Incremento 1R).
// La asociación estudiante–grupo conserva vigencia e historial, pero no representa
// una matrícula formal. Las restricciones parciales y entre tablas están en SQL.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Acceso ----------
enum EstadoUsuario {
  PENDIENTE_ACTIVACION
  ACTIVO
  INACTIVO
}

// Personaje que el estudiante elige en «Mi explorador». Preferencia de
// presentación, no dato personal. Nulo equivale a CASITA. Avatares provisionales 🔶.
enum AvatarExplorador {
  CASITA
  PINO
  GOTA
  SOL
}

model Usuario {
  id             String        @id @default(cuid())
  nombres        String
  apellidos      String
  correo         String        @unique
  hashContrasena String?
  fotoUrl        String?
  estado         EstadoUsuario @default(PENDIENTE_ACTIVACION)
  debeCambiarContrasena Boolean @default(false)
  versionSesion  Int           @default(1)
  sesionesRevocadasEn DateTime?
  ultimoContexto String?
  ultimoAcceso   DateTime?
  avatar         AvatarExplorador?
  creadoEn       DateTime      @default(now())
  actualizadoEn  DateTime      @updatedAt

  roles             UsuarioRol[]
  restablecimientos RestablecimientoContrasena[]
  gruposDirigidos   Grupo[]                      @relation("Director")
  asignaciones      AsignacionDocente[]          @relation("DocenteAsignaciones")
  asignacionesCreadas AsignacionDocente[]        @relation("AsignacionCreador")
  asociacionesGrupo AsociacionEstudianteGrupo[]  @relation("EstudianteAsociaciones")
  integracionGoogle IntegracionGoogle?
  solicitudesEntregaCreadas SolicitudEntrega[] @relation("CreadorSolicitudesEntrega")
  entregasDocente EntregaDocente[] @relation("DestinatariaEntrega")
  desafiosGoogle DesafioGoogle[]
  actividadesCreadas Actividad[] @relation("AutorActividades")
  asignacionesActividadCreadas AsignacionActividad[] @relation("CreadorAsignacionesActividad")
  intentosActividad IntentoActividad[] @relation("EstudianteIntentosActividad")
  resultadosActividad ResultadoActividad[] @relation("EstudianteResultadosActividad")

  @@map("usuarios")
}

model Rol {
  id          String       @id @default(cuid())
  codigo      String       @unique // ADMIN | DOCENTE | ESTUDIANTE
  nombre      String
  descripcion String?
  usuarios    UsuarioRol[]

  @@map("roles")
}

model UsuarioRol {
  usuarioId String
  rolId     String
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  rol       Rol     @relation(fields: [rolId], references: [id], onDelete: Cascade)

  @@id([usuarioId, rolId])
  @@map("usuarios_roles")
}

model RestablecimientoContrasena {
  id        String    @id @default(cuid())
  usuarioId String
  tokenHash String    @unique
  tipo      String    @default("RECUPERACION") // RECUPERACION | INVITACION (trigger SQL)
  expiraEn  DateTime
  usadoEn   DateTime?
  creadoEn  DateTime  @default(now())
  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("restablecimientos_contrasena")
}

// ---------- Estructura académica (t_b089e01a) ----------
// Reglas que SQL no expresa y se validan en src/server/modules/academico:
// RN-01 un solo año ACTIVO · RN-02 períodos sin solape y dentro del año ·
// RN-06 ponderaciones = 100 % · RN-52 año CERRADO es solo lectura.

enum EstadoAnioLectivo {
  ACTIVO
  CERRADO
}

model AnioLectivo {
  id            String            @id @default(cuid())
  anio          Int               @unique
  fechaInicio   DateTime
  fechaFin      DateTime
  estado        EstadoAnioLectivo @default(ACTIVO)
  creadoEn      DateTime          @default(now())
  actualizadoEn DateTime          @updatedAt
  periodos      Periodo[]
  grupos        Grupo[]
  asignacionesDocente AsignacionDocente[]
  asociacionesEstudiantes AsociacionEstudianteGrupo[]

  @@map("anios_lectivos")
}

model Periodo {
  id            String      @id @default(cuid())
  anioLectivoId String
  nombre        String
  orden         Int
  fechaInicio   DateTime
  fechaFin      DateTime
  ponderacion   Decimal // porcentaje; suma anual = 100 (RN-06)
  creadoEn      DateTime    @default(now())
  actualizadoEn DateTime    @updatedAt
  anioLectivo   AnioLectivo @relation(fields: [anioLectivoId], references: [id])
  solicitudesEntrega SolicitudEntrega[]
  asignacionesActividad AsignacionActividad[]

  @@unique([anioLectivoId, orden])
  @@map("periodos")
}

enum NivelEducativo {
  PREESCOLAR
  PRIMARIA
  BACHILLERATO
}

model Grado {
  id            String            @id @default(cuid())
  nombre        String            @unique
  nivel         NivelEducativo
  orden         Int               @unique
  creadoEn      DateTime          @default(now())
  actualizadoEn DateTime          @updatedAt
  grupos        Grupo[]
  asignaturas   AsignaturaGrado[]
  actividades Actividad[]

  @@map("grados")
}

model Grupo {
  id            String      @id @default(cuid())
  gradoId       String
  anioLectivoId String
  identificador String // "01", "02"
  directorId    String?
  creadoEn      DateTime    @default(now())
  actualizadoEn DateTime    @updatedAt
  grado         Grado       @relation(fields: [gradoId], references: [id])
  anioLectivo   AnioLectivo @relation(fields: [anioLectivoId], references: [id])
  director      Usuario?    @relation("Director", fields: [directorId], references: [id], onDelete: SetNull)
  asignacionesDocente AsignacionDocente[]
  asociacionesEstudiantes AsociacionEstudianteGrupo[]
  asignacionesActividad AsignacionActividad[]

  @@unique([gradoId, anioLectivoId, identificador]) // RN-07
  @@index([anioLectivoId])
  @@map("grupos")
}

enum TipoArea {
  AREA
  DIMENSION
  ENFOQUE
}

model Area {
  id            String       @id @default(cuid())
  nombre        String
  tipo          TipoArea     @default(AREA) // RN-13
  idioma        String       @default("es") // RN-14
  orden         Int?
  creadoEn      DateTime     @default(now())
  actualizadoEn DateTime     @updatedAt
  asignaturas   Asignatura[]

  @@unique([nombre, idioma])
  @@map("areas")
}

model Asignatura {
  id                String            @id @default(cuid())
  nombre            String
  areaId            String
  intensidadHoraria Int? // 🔶
  creadoEn          DateTime          @default(now())
  actualizadoEn     DateTime          @updatedAt
  area              Area              @relation(fields: [areaId], references: [id])
  grados            AsignaturaGrado[]
  asignacionesDocente AsignacionDocente[]
  actividades Actividad[]

  @@unique([areaId, nombre])
  @@map("asignaturas")
}

model AsignaturaGrado {
  asignaturaId String
  gradoId      String
  intensidad   Int? // horas semanales en ese grado (RN-09) 🔶
  asignatura   Asignatura @relation(fields: [asignaturaId], references: [id], onDelete: Cascade)
  grado        Grado      @relation(fields: [gradoId], references: [id], onDelete: Cascade)

  @@id([asignaturaId, gradoId])
  @@map("asignaturas_grados")
}

enum EstadoAsignacionDocente {
  ACTIVA
  INACTIVA
}

model AsignacionDocente {
  id            String                  @id @default(cuid())
  docenteId     String
  asignaturaId  String
  grupoId       String
  anioLectivoId String
  estado        EstadoAsignacionDocente @default(ACTIVA)
  creadoPorId   String?
  creadoEn      DateTime                @default(now())
  actualizadoEn DateTime                @updatedAt
  docente       Usuario                 @relation("DocenteAsignaciones", fields: [docenteId], references: [id])
  asignatura    Asignatura              @relation(fields: [asignaturaId], references: [id])
  grupo         Grupo                   @relation(fields: [grupoId], references: [id])
  anioLectivo   AnioLectivo             @relation(fields: [anioLectivoId], references: [id])
  creadoPor     Usuario?                @relation("AsignacionCreador", fields: [creadoPorId], references: [id], onDelete: SetNull)
  bloques       BloqueHorario[]
  asignacionesActividad AsignacionActividad[]
  @@index([docenteId, asignaturaId, grupoId, anioLectivoId])
  @@index([docenteId, anioLectivoId])
  @@map("asignaciones_docente")
}

model AsociacionEstudianteGrupo {
  id            String      @id @default(cuid())
  estudianteId  String
  grupoId       String
  anioLectivoId String
  inicioEn      DateTime    @default(now())
  finEn         DateTime?
  creadoEn      DateTime    @default(now())
  actualizadoEn DateTime    @updatedAt
  estudiante    Usuario     @relation("EstudianteAsociaciones", fields: [estudianteId], references: [id])
  grupo         Grupo       @relation(fields: [grupoId], references: [id])
  anioLectivo   AnioLectivo @relation(fields: [anioLectivoId], references: [id])

  @@index([estudianteId, anioLectivoId])
  @@index([grupoId, finEn])
  @@map("asociaciones_estudiantes_grupos")
}

enum DiaSemana {
  LUNES
  MARTES
  MIERCOLES
  JUEVES
  VIERNES
  SABADO
  DOMINGO
}

model BloqueHorario {
  id            String             @id @default(cuid())
  asignacionId  String
  dia           DiaSemana
  horaInicio    String
  horaFin       String
  creadoEn      DateTime           @default(now())
  actualizadoEn DateTime           @updatedAt
  asignacion    AsignacionDocente  @relation(fields: [asignacionId], references: [id], onDelete: Cascade)

  @@unique([asignacionId, dia, horaInicio, horaFin])
  @@index([dia, horaInicio, horaFin])
  @@map("bloques_horario")
}

// ---------- Entregas a coordinación ----------
enum EstadoIntegracion {
  CONECTADA
  REVOCADA
}

enum TipoDocumentoEntrega {
  PLANILLA_NOTAS
  PLANEACION
  OBSERVADOR
  INFORME
  OTRO
}

enum EstadoSolicitudEntrega {
  ABIERTA
  ARCHIVADA
}

model IntegracionGoogle {
  id String @id @default(cuid())
  usuarioId String @unique
  correoGoogle String
  refreshTokenCifrado String?
  scopes String[]
  estado EstadoIntegracion @default(CONECTADA)
  conectadaEn DateTime @default(now())
  actualizadoEn DateTime @updatedAt
  usuario Usuario @relation(fields: [usuarioId], references: [id])
  solicitudes SolicitudEntrega[]

  @@map("integraciones_google")
}

model DesafioGoogle {
  stateHash String @id
  usuarioId String
  expiraEn DateTime
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([expiraEn])
  @@map("desafios_google")
}

model SolicitudEntrega {
  id String @id @default(cuid())
  titulo String
  descripcion String?
  tipoDocumento TipoDocumentoEntrega
  formatos String[]
  cierraEn DateTime @db.Timestamptz(3)
  periodoId String?
  carpetaDriveId String
  carpetaDriveNombre String
  carpetaRequiereSeleccion Boolean @default(false)
  integracionId String?
  estado EstadoSolicitudEntrega @default(ABIERTA)
  creadaPorId String
  creadaEn DateTime @default(now())
  actualizadaEn DateTime @updatedAt
  periodo Periodo? @relation(fields: [periodoId], references: [id], onDelete: SetNull)
  integracion IntegracionGoogle? @relation(fields: [integracionId], references: [id], onDelete: SetNull)
  creadaPor Usuario @relation("CreadorSolicitudesEntrega", fields: [creadaPorId], references: [id])
  entregas EntregaDocente[]

  @@index([estado, cierraEn])
  @@map("solicitudes_entrega")
}

model EntregaDocente {
  id String @id @default(cuid())
  solicitudId String
  docenteId String
  ultimoFalloEn DateTime?
  creadoEn DateTime @default(now())
  solicitud SolicitudEntrega @relation(fields: [solicitudId], references: [id], onDelete: Cascade)
  docente Usuario @relation("DestinatariaEntrega", fields: [docenteId], references: [id])
  archivos ArchivoEntrega[]

  @@unique([solicitudId, docenteId])
  @@index([docenteId])
  @@map("entregas_docente")
}

model ArchivoEntrega {
  id String @id @default(cuid())
  entregaId String
  version Int
  driveFileId String
  nombreDrive String
  nombreOriginal String
  tamanoBytes Int
  sha256 String
  mime String
  subidoEn DateTime @default(now()) @db.Timestamptz(3)
  entrega EntregaDocente @relation(fields: [entregaId], references: [id], onDelete: Cascade)

  @@unique([entregaId, version])
  @@map("archivos_entrega")
}

// ---------- Núcleo de actividades ----------
enum OrigenActividad {
  CURRICULO
  DOCENTE
}

enum EstadoActividad {
  PUBLICADA
  RETIRADA
}

enum EstadoAsignacionActividad {
  PUBLICADA
  ANULADA
}

enum EstadoIntento {
  EN_CURSO
  ENVIADO
  ABANDONADO
}

model Actividad {
  id String @id @default(cuid())
  huellaCreacion String? @unique
  titulo String
  instruccion String?
  tipo String
  asignaturaId String
  gradoId String
  origen OrigenActividad @default(DOCENTE)
  autorId String?
  estado EstadoActividad @default(PUBLICADA)
  creadoEn DateTime @default(now()) @db.Timestamptz(3)
  actualizadoEn DateTime @updatedAt @db.Timestamptz(3)
  asignatura Asignatura @relation(fields: [asignaturaId], references: [id])
  grado Grado @relation(fields: [gradoId], references: [id])
  autor Usuario? @relation("AutorActividades", fields: [autorId], references: [id])
  versiones VersionActividad[]

  @@index([asignaturaId, gradoId, estado])
  @@index([autorId, estado])
  @@map("actividades")
}

model VersionActividad {
  id String @id @default(cuid())
  actividadId String
  numero Int @default(1)
  tipo String
  versionEsquema Int
  contenido Json
  puntajeMaximo Decimal @db.Decimal(10, 2)
  hash String
  actividad Actividad @relation(fields: [actividadId], references: [id])
  asignaciones AsignacionActividad[]

  @@unique([actividadId, numero])
  @@map("versiones_actividad")
}

model AsignacionActividad {
  id String @id @default(cuid())
  versionActividadId String
  asignacionDocenteId String
  grupoId String
  periodoId String
  abreEn DateTime @db.Timestamptz(3)
  cierraEn DateTime @db.Timestamptz(3)
  maxIntentos Int @default(3)
  cuentaComoNota Boolean @default(true)
  estado EstadoAsignacionActividad @default(PUBLICADA)
  creadoPorId String
  creadoEn DateTime @default(now()) @db.Timestamptz(3)
  actualizadoEn DateTime @updatedAt @db.Timestamptz(3)
  versionActividad VersionActividad @relation(fields: [versionActividadId], references: [id])
  asignacionDocente AsignacionDocente @relation(fields: [asignacionDocenteId], references: [id])
  grupo Grupo @relation(fields: [grupoId], references: [id])
  periodo Periodo @relation(fields: [periodoId], references: [id])
  creadoPor Usuario @relation("CreadorAsignacionesActividad", fields: [creadoPorId], references: [id])
  intentos IntentoActividad[]
  resultados ResultadoActividad[]

  @@index([grupoId, estado, abreEn])
  @@index([asignacionDocenteId, estado])
  @@index([versionActividadId])
  @@map("asignaciones_actividad")
}

model IntentoActividad {
  id String @id @default(cuid())
  asignacionId String
  estudianteId String
  numero Int
  estado EstadoIntento @default(EN_CURSO)
  vioVideoEn DateTime? @db.Timestamptz(3)
  iniciadoEn DateTime @default(now()) @db.Timestamptz(3)
  enviadoEn DateTime? @db.Timestamptz(3)
  puntaje Decimal? @db.Decimal(10, 2)
  porcentaje Decimal? @db.Decimal(5, 2)
  asignacion AsignacionActividad @relation(fields: [asignacionId], references: [id])
  estudiante Usuario @relation("EstudianteIntentosActividad", fields: [estudianteId], references: [id])
  respuestas RespuestaItem[]
  resultadosMejores ResultadoActividad[] @relation("MejorIntentoActividad")

  @@unique([asignacionId, estudianteId, numero])
  @@index([estudianteId, estado])
  @@map("intentos_actividad")
}

model RespuestaItem {
  id String @id @default(cuid())
  intentoId String
  itemId String
  respuesta Json
  correcta Boolean
  puntaje Decimal @db.Decimal(10, 2)
  intento IntentoActividad @relation(fields: [intentoId], references: [id])

  @@unique([intentoId, itemId])
  @@map("respuestas_item")
}

model ResultadoActividad {
  id String @id @default(cuid())
  asignacionId String
  estudianteId String
  mejorIntentoId String
  porcentaje Decimal @db.Decimal(5, 2)
  asignacion AsignacionActividad @relation(fields: [asignacionId], references: [id])
  estudiante Usuario @relation("EstudianteResultadosActividad", fields: [estudianteId], references: [id])
  mejorIntento IntentoActividad @relation("MejorIntentoActividad", fields: [mejorIntentoId], references: [id])

  @@unique([asignacionId, estudianteId])
  @@map("resultados_actividad")
}
