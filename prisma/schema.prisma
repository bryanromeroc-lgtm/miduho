// MIDUHO — esquema Prisma (Incremento 1R).
// La asociación estudiante–grupo conserva vigencia e historial, pero no representa
// una matrícula formal. Las restricciones parciales y entre tablas están en SQL.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite" // desarrollo; producción: "postgresql" 🔶 pendiente de hospedaje
}

// ---------- Acceso ----------
enum EstadoUsuario {
  PENDIENTE_ACTIVACION
  ACTIVO
  INACTIVO
}

model Usuario {
  id             String        @id @default(cuid())
  nombres        String
  apellidos      String
  correo         String        @unique
  hashContrasena String?
  fotoUrl        String?
  estado         EstadoUsuario @default(PENDIENTE_ACTIVACION)
  debeCambiarContrasena Boolean @default(false)
  versionSesion  Int           @default(1)
  sesionesRevocadasEn DateTime?
  ultimoContexto String?
  ultimoAcceso   DateTime?
  creadoEn       DateTime      @default(now())
  actualizadoEn  DateTime      @updatedAt

  roles             UsuarioRol[]
  restablecimientos RestablecimientoContrasena[]
  gruposDirigidos   Grupo[]                      @relation("Director")
  asignaciones      AsignacionDocente[]          @relation("DocenteAsignaciones")
  asignacionesCreadas AsignacionDocente[]        @relation("AsignacionCreador")
  asociacionesGrupo AsociacionEstudianteGrupo[]  @relation("EstudianteAsociaciones")

  @@map("usuarios")
}

model Rol {
  id          String       @id @default(cuid())
  codigo      String       @unique // ADMIN | DOCENTE | ESTUDIANTE
  nombre      String
  descripcion String?
  usuarios    UsuarioRol[]

  @@map("roles")
}

model UsuarioRol {
  usuarioId String
  rolId     String
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  rol       Rol     @relation(fields: [rolId], references: [id], onDelete: Cascade)

  @@id([usuarioId, rolId])
  @@map("usuarios_roles")
}

model RestablecimientoContrasena {
  id        String    @id @default(cuid())
  usuarioId String
  tokenHash String    @unique
  expiraEn  DateTime
  usadoEn   DateTime?
  creadoEn  DateTime  @default(now())
  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("restablecimientos_contrasena")
}

// ---------- Estructura académica (t_b089e01a) ----------
// Reglas que SQL no expresa y se validan en src/server/modules/academico:
// RN-01 un solo año ACTIVO · RN-02 períodos sin solape y dentro del año ·
// RN-06 ponderaciones = 100 % · RN-52 año CERRADO es solo lectura.

enum EstadoAnioLectivo {
  ACTIVO
  CERRADO
}

model AnioLectivo {
  id            String            @id @default(cuid())
  anio          Int               @unique
  fechaInicio   DateTime
  fechaFin      DateTime
  estado        EstadoAnioLectivo @default(ACTIVO)
  creadoEn      DateTime          @default(now())
  actualizadoEn DateTime          @updatedAt
  periodos      Periodo[]
  grupos        Grupo[]
  asignacionesDocente AsignacionDocente[]
  asociacionesEstudiantes AsociacionEstudianteGrupo[]

  @@map("anios_lectivos")
}

model Periodo {
  id            String      @id @default(cuid())
  anioLectivoId String
  nombre        String
  orden         Int
  fechaInicio   DateTime
  fechaFin      DateTime
  ponderacion   Decimal // porcentaje; suma anual = 100 (RN-06)
  creadoEn      DateTime    @default(now())
  actualizadoEn DateTime    @updatedAt
  anioLectivo   AnioLectivo @relation(fields: [anioLectivoId], references: [id])

  @@unique([anioLectivoId, orden])
  @@map("periodos")
}

enum NivelEducativo {
  PREESCOLAR
  PRIMARIA
  BACHILLERATO
}

model Grado {
  id            String            @id @default(cuid())
  nombre        String            @unique
  nivel         NivelEducativo
  orden         Int               @unique
  creadoEn      DateTime          @default(now())
  actualizadoEn DateTime          @updatedAt
  grupos        Grupo[]
  asignaturas   AsignaturaGrado[]

  @@map("grados")
}

model Grupo {
  id            String      @id @default(cuid())
  gradoId       String
  anioLectivoId String
  identificador String // "01", "02"
  directorId    String?
  creadoEn      DateTime    @default(now())
  actualizadoEn DateTime    @updatedAt
  grado         Grado       @relation(fields: [gradoId], references: [id])
  anioLectivo   AnioLectivo @relation(fields: [anioLectivoId], references: [id])
  director      Usuario?    @relation("Director", fields: [directorId], references: [id], onDelete: SetNull)
  asignacionesDocente AsignacionDocente[]
  asociacionesEstudiantes AsociacionEstudianteGrupo[]

  @@unique([gradoId, anioLectivoId, identificador]) // RN-07
  @@index([anioLectivoId])
  @@map("grupos")
}

enum TipoArea {
  AREA
  DIMENSION
  ENFOQUE
}

model Area {
  id            String       @id @default(cuid())
  nombre        String
  tipo          TipoArea     @default(AREA) // RN-13
  idioma        String       @default("es") // RN-14
  orden         Int?
  creadoEn      DateTime     @default(now())
  actualizadoEn DateTime     @updatedAt
  asignaturas   Asignatura[]

  @@unique([nombre, idioma])
  @@map("areas")
}

model Asignatura {
  id                String            @id @default(cuid())
  nombre            String
  areaId            String
  intensidadHoraria Int? // 🔶
  creadoEn          DateTime          @default(now())
  actualizadoEn     DateTime          @updatedAt
  area              Area              @relation(fields: [areaId], references: [id])
  grados            AsignaturaGrado[]
  asignacionesDocente AsignacionDocente[]

  @@unique([areaId, nombre])
  @@map("asignaturas")
}

model AsignaturaGrado {
  asignaturaId String
  gradoId      String
  intensidad   Int? // horas semanales en ese grado (RN-09) 🔶
  asignatura   Asignatura @relation(fields: [asignaturaId], references: [id], onDelete: Cascade)
  grado        Grado      @relation(fields: [gradoId], references: [id], onDelete: Cascade)

  @@id([asignaturaId, gradoId])
  @@map("asignaturas_grados")
}

enum EstadoAsignacionDocente {
  ACTIVA
  INACTIVA
}

model AsignacionDocente {
  id            String                  @id @default(cuid())
  docenteId     String
  asignaturaId  String
  grupoId       String
  anioLectivoId String
  estado        EstadoAsignacionDocente @default(ACTIVA)
  creadoPorId   String?
  creadoEn      DateTime                @default(now())
  actualizadoEn DateTime                @updatedAt
  docente       Usuario                 @relation("DocenteAsignaciones", fields: [docenteId], references: [id])
  asignatura    Asignatura              @relation(fields: [asignaturaId], references: [id])
  grupo         Grupo                   @relation(fields: [grupoId], references: [id])
  anioLectivo   AnioLectivo             @relation(fields: [anioLectivoId], references: [id])
  creadoPor     Usuario?                @relation("AsignacionCreador", fields: [creadoPorId], references: [id], onDelete: SetNull)
  bloques       BloqueHorario[]
  @@unique([docenteId, asignaturaId, grupoId, anioLectivoId])
  @@index([docenteId, anioLectivoId])
  @@map("asignaciones_docente")
}

model AsociacionEstudianteGrupo {
  id            String      @id @default(cuid())
  estudianteId  String
  grupoId       String
  anioLectivoId String
  inicioEn      DateTime    @default(now())
  finEn         DateTime?
  creadoEn      DateTime    @default(now())
  actualizadoEn DateTime    @updatedAt
  estudiante    Usuario     @relation("EstudianteAsociaciones", fields: [estudianteId], references: [id])
  grupo         Grupo       @relation(fields: [grupoId], references: [id])
  anioLectivo   AnioLectivo @relation(fields: [anioLectivoId], references: [id])

  @@index([estudianteId, anioLectivoId])
  @@index([grupoId, finEn])
  @@map("asociaciones_estudiantes_grupos")
}

enum DiaSemana {
  LUNES
  MARTES
  MIERCOLES
  JUEVES
  VIERNES
  SABADO
  DOMINGO
}

model BloqueHorario {
  id            String             @id @default(cuid())
  asignacionId  String
  dia           DiaSemana
  horaInicio    String
  horaFin       String
  creadoEn      DateTime           @default(now())
  actualizadoEn DateTime           @updatedAt
  asignacion    AsignacionDocente  @relation(fields: [asignacionId], references: [id], onDelete: Cascade)

  @@unique([asignacionId, dia, horaInicio, horaFin])
  @@index([dia, horaInicio, horaFin])
  @@map("bloques_horario")
}
